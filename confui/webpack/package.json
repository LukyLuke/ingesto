{
  "name": "ingesto-confui",
  "version": "0.1.0",
  "description": "create an app to consume rust-generated wasm packages",
  "main": "index.js",
  "bin": {
    "create-wasm-app": ".bin/create-wasm-app.js"
  },
  "scripts": {
    "tailwind:build": "npx @tailwindcss/cli -i ./main.css -o ./output.css --minify",
    "build": "npm run tailwind:build && webpack --config webpack.config.js",
    "start": "npm run tailwind:build && webpack-dev-server --config webpack.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukyLuke/ingesto.git"
  },
  "author": "Lukas LukyLuke_ch Zurschmiede <lukas.zurschmiede@ranta.ch>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/LukyLuke/ingesto/issues"
  },
  "homepage": "https://github.com/LukyLuke/ingesto",
  "devDependencies": {
    "@wasm-tool/wasm-pack-plugin": "^1.7.0",
    "css-loader": "7.1.4",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "4.0.0",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3"
  }
}
